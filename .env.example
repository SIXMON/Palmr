# =============================================================================
# Palmr — environment file for docker-compose
# =============================================================================
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Variables marked REQUIRED have no safe default — compose will fail without them.

# -----------------------------------------------------------------------------
# Object storage (MinIO) — REQUIRED
# -----------------------------------------------------------------------------
# Use long random strings. Treat MINIO_ROOT_PASSWORD as a database password.
# Generate: openssl rand -hex 24
MINIO_ROOT_USER=palmr-minio-admin
MINIO_ROOT_PASSWORD=change-me-to-a-strong-random-password

# Bucket name — created on first boot by the minio-init service.
MINIO_BUCKET=palmr-files

# Region label used in S3 signing. Any string works as long as it matches
# what the backend sends; the default is fine for MinIO.
MINIO_REGION=us-east-1

# Host ports for MinIO. The API port must remain reachable from browsers
# (presigned URLs). The console port is admin-only — keep it firewalled.
MINIO_API_PORT=9379
MINIO_CONSOLE_PORT=9378

# -----------------------------------------------------------------------------
# Backend (palmr-server) — REQUIRED
# -----------------------------------------------------------------------------
# JWT signing key. At least 32 characters; longer is better.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-with-openssl-rand-hex-32

# Comma-separated list of origins allowed to call the API (used by CORS).
# Must include the public URL of the Palmr web UI.
# Example: https://palmr.example.com,https://palmr-admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5487

# Set to "true" when the public URL is HTTPS so cookies get the Secure flag.
SECURE_SITE=true

# Public, browser-reachable URL of the MinIO API service. The backend hands
# this out in presigned URLs so the browser uploads/downloads directly.
# - Local dev:           http://localhost:9379
# - Behind a TLS proxy:  https://storage.palmr.example.com
STORAGE_URL=http://localhost:9379

# Backend body limit (used for multipart uploads and presigned negotiations).
MAX_BODY_SIZE_MB=100

# bcrypt cost factor (10–16). 12 is the OWASP minimum for 2024.
BCRYPT_COST=12

# Presigned URL TTL in seconds (1h default).
PRESIGNED_URL_EXPIRATION=3600

# Host port for the backend API. Unused by default — Traefik routes
# `/api/*` to palmr-server on the docker network, so you only need to
# publish this port if you want direct backend access (uncomment the
# `ports:` block on palmr-server in docker-compose.yaml).
SERVER_PORT=3333

# -----------------------------------------------------------------------------
# Public HTTP port (Traefik front door)
# -----------------------------------------------------------------------------
# Traefik exposes a single HTTP entrypoint that serves both the Next.js UI
# (`/`) and the Fastify API (`/api/*`). Point your upstream TLS proxy
# (Cloudflare, nginx, etc) at this port.
WEB_PORT=5487
DEFAULT_LANGUAGE=en-US

# -----------------------------------------------------------------------------
# Runtime user
# -----------------------------------------------------------------------------
# UID/GID for the unprivileged process inside the containers. Override if
# you bind-mount host directories and need ownership to match.
PALMR_UID=1001
PALMR_GID=1001
